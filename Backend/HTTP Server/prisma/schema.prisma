generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Device{
  id              Int        @id @default(autoincrement())
  images          Image[]   
  temperature     Float
  humidity        Float

}

model Image{
  id              Int @id @default(autoincrement())
  timestamp       DateTime 
  imageURL        String  
  deviceId        Int
  device          Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}


